# Packages under the @aumraa scope (packages/breathe-ui, packages/lemniscate,
# packages/kaayo) publish to and install from GitHub Packages, not npmjs.com.
# Requires a GitHub token with read:packages (install) / write:packages
# (publish) scope, exported as NODE_AUTH_TOKEN or set via `npm login
# --scope=@aumraa --registry=https://npm.pkg.github.com`.
@aumraa:registry=https://npm.pkg.github.com
