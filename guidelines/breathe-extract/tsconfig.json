{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "allowJs": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strictNullChecks": false,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../src/*"]
    },
    "typeRoots": [
      "../../node_modules/@types",
      "../../node_modules/.pnpm/@types+react@19.2.14/node_modules/@types"
    ]
  },
  "include": ["components/**/*.tsx", "components/**/*.ts"]
}
