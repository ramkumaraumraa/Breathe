{
  "name": "@aumraa/breathe-ui",
  "version": "0.1.0",
  "description": "Breathe's dependency-free web component layer — no Radix, no shadcn, no MUI. Shared base that @aumraa/lemniscate-ui and @aumraa/kaayo-ui re-theme.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": "https://github.com/AUMRAA/Breathe",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": false,
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.tsx"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "node scripts/copy-source.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "lucide-react": "0.487.0",
    "next-themes": "0.4.6",
    "react-day-picker": "8.10.1",
    "react-hook-form": "7.55.0",
    "react-resizable-panels": "2.1.7",
    "recharts": "2.15.2",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0"
  },
  "peerDependencies": {
    "react": ">=18.3.1",
    "react-dom": ">=18.3.1"
  }
}
